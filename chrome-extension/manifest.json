{
  "manifest_version": 3,
  "name": "Raw Image Save To Folder",
  "version": "0.5.2",
  "description": "Save MangaRaw and Soraraw chapter images to a chosen folder.",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://mangaraw.ma/*",
    "https://img-cdn.stackpathcdn.app/*",
    "https://soraraw.com/*",
    "https://api.mangarawgo.site/*",
    "https://*.rawcontent.top/*",
    "https://lh3.googleusercontent.com/*",
    "https://i.mangaraw.lat/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mangaraw.ma/manga/*/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mangaraw.ma/manga/*"
      ],
      "js": [
        "content-mangaraw.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://soraraw.com/*"
      ],
      "js": [
        "content-soraraw.js"
      ],
      "run_at": "document_start"
    }
  ]
}
